# Neon or another Vercel-compatible PostgreSQL database.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Disabled by default. Enable only after 0010_prediction_v2_shadow.sql and the
# inactive V2 seed have been reviewed/applied in the target environment.
PREDICTION_V2_SHADOW_WRITE_ENABLED=false

# A long random value used to HMAC request identifiers for distributed rate limiting.
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
